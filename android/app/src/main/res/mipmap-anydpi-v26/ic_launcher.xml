<?xml version="1.0" encoding="utf-8"?>
<!-- Both layers are written by scripts/apply-config.mjs from the app config.
     No monochrome layer: themed icons tint by alpha, which turns a customer's
     full-colour artwork into a solid block. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MonochromeLauncherIcon">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
